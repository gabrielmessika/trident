HIP4_OUTCOME_MODE=paper
HIP4_OUTCOME_CONFIG=config/hip4_outcome_mainnet_paper.toml
HIP4_OUTCOME_ALLOW_TESTNET_ORDERS=false
HIP4_OUTCOME_API_PORT=3001

# Optional. In paper mode these are not required for mainnet execution.
# Keep real keys only on the server.
HIP4_OUTCOME_ACCOUNT_ADDRESS=
HIP4_OUTCOME_SECRET_KEY=
HIP4_OUTCOME_VAULT_ADDRESS=

# Optional sidecar observer.
TRIDENT_HIP4_ENABLE_MAINNET_OBSERVER=
HIP4_OUTCOME_MAINNET_CONFIG=config/hip4_outcome_mainnet_observer.toml

# Testnet helpers, only for explicit testnet preflight work.
HIP4_OUTCOME_TESTNET_BALANCE_COIN=USDH
HIP4_OUTCOME_AUTO_TRANSFER_TESTNET_SPOT_USDC=false
HIP4_OUTCOME_TESTNET_SPOT_TRANSFER_TARGET_USDC=37
