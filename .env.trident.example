TRIDENT_MODE=dry-run
TRIDENT_EXCHANGE_NETWORK=mainnet
TRIDENT_PROFILE=trident
TRIDENT_HOST=127.0.0.1
TRIDENT_PORT=3000
TRIDENT_LOG_LEVEL=info
TRIDENT_CONFIG_PATH=config/trident.toml

# Live launch credentials. Keep this file only on the server.
# TRIDENT_ACCOUNT_ADDRESS is the real master/subaccount/vault address to query.
# TRIDENT_SECRET_KEY is the approved API wallet private key used only for signing.
TRIDENT_ACCOUNT_ADDRESS=
TRIDENT_SECRET_KEY=
TRIDENT_VAULT_ADDRESS=

# HIP-4 Pod B can use a dedicated testnet wallet or sub-account.
# For a sub-account, set HIP4_OUTCOME_ACCOUNT_ADDRESS and HIP4_OUTCOME_VAULT_ADDRESS
# to the sub-account address, and HIP4_OUTCOME_SECRET_KEY to its dedicated API wallet key.
HIP4_OUTCOME_ACCOUNT_ADDRESS=
HIP4_OUTCOME_SECRET_KEY=
HIP4_OUTCOME_VAULT_ADDRESS=
HIP4_OUTCOME_TESTNET_BALANCE_COIN=USDH
HIP4_OUTCOME_AUTO_TRANSFER_TESTNET_SPOT_USDC=false
HIP4_OUTCOME_TESTNET_SPOT_TRANSFER_TARGET_USDC=37

# HIP-4 mainnet observer runs in the same dry-run deployment as Pod B.
# It never receives credentials and never places orders.
TRIDENT_ENABLE_HIP4_MAINNET_OBSERVER=true
HIP4_OUTCOME_MAINNET_CONFIG=config/hip4_outcome_mainnet_observer.toml

# Required before any real order can be sent.
TRIDENT_LIVE_CONFIRM=

# Optional per-pod live state paths. Defaults keep Pod A and Pod C separated.
# With --network testnet, scripts default to runtime/trident/live_state_testnet_pod_*.json.
TRIDENT_LIVE_STATE_PATH_POD_A=
TRIDENT_LIVE_STATE_PATH_POD_C=

# Optional live recovery switches. Defaults are strict.
TRIDENT_LIVE_ALLOW_UNKNOWN_POSITIONS=
TRIDENT_LIVE_ALLOW_OPEN_ORDERS=
TRIDENT_LIVE_SKIP_USER_WS_CHECK=

# Optional TP/SL trigger liquidity source. If set, the collector uses
# QuickNode HyperCore `orders` blocks instead of local node_order_statuses.
# Keep the real URL only on the server because the path contains the token.
TRIDENT_TRIGGER_LIQUIDITY_QUICKNODE_URL=
TRIDENT_TRIGGER_LIQUIDITY_QUICKNODE_STREAM=orders
# QuickNode Discover/free accounts limit hl_getBatchBlocks ranges to 5 blocks.
TRIDENT_TRIGGER_LIQUIDITY_QUICKNODE_BATCH_SIZE=5
TRIDENT_TRIGGER_LIQUIDITY_QUICKNODE_INITIAL_LOOKBACK_BLOCKS=25
TRIDENT_TRIGGER_LIQUIDITY_QUICKNODE_MAX_BLOCKS_PER_POLL=300
TRIDENT_TRIGGER_LIQUIDITY_POLL_SECONDS=1

# Optional historical TP/SL backfill through QuickNode SQL Explorer.
# This is a dashboard/API key, not necessarily the HyperCore endpoint token.
TRIDENT_TRIGGER_LIQUIDITY_SQL_API_KEY=
